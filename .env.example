# ==============================================================================
# ReMind Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env:
#   cp .env.example backend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application & Database
# ------------------------------------------------------------------------------
# App environment: 'development' or 'production'
APP_ENV=development

# Database connection:
# Default SQLite fallback (local development):
# DATABASE_URL=sqlite:///remind.db
# PostgreSQL with pgvector (production / docker-compose):
DATABASE_URL=postgresql+psycopg://remind:remind@localhost:5432/remind

# Secret key used for signing JWT authentication tokens
JWT_SECRET=replace-with-a-long-random-value

# Maximum document upload file size in Megabytes (PDF, DOCX, TXT, MD)
MAX_UPLOAD_MB=20

# ------------------------------------------------------------------------------
# AI Provider Mode & Concurrency
# ------------------------------------------------------------------------------
# Default provider mode: 'ollama', 'groq', 'gemini', or 'auto'
AI_PROVIDER_MODE=ollama

# Maximum concurrent requests sent to local AI / Ollama (protective for low VRAM)
AI_CONCURRENCY_LIMIT=1

# ------------------------------------------------------------------------------
# Ollama (Local AI - Embeddings & Generation)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# Generation model (e.g., 'qwen3:4b', 'qwen2.5:3b')
OLLAMA_LLM_MODEL=qwen3:4b

# Embedding model for document chunking and vector search (always runs locally)
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Request timeout and retries
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=2

# Generation parameters
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1200

# ------------------------------------------------------------------------------
# Groq (Cloud AI - High-Speed Generation)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE=https://api.groq.com/openai/v1

# Supported models: 'openai/gpt-oss-20b', 'qwen/qwen3.8-27b', 'openai/gpt-oss-120b'
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b

GROQ_TIMEOUT_SECONDS=120
GROQ_TEMPERATURE=0.2
GROQ_RETRY_ATTEMPTS=2

# ------------------------------------------------------------------------------
# Google Gemini (Cloud AI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Supported models: 'gemini-2.0-flash', 'gemini-flash-latest'
GEMINI_MODEL=gemini-2.0-flash

GEMINI_TIMEOUT_SECONDS=120
GEMINI_RETRY_ATTEMPTS=2

# ------------------------------------------------------------------------------
# RAG (Retrieval-Augmented Generation) & Retrieval Parameters
# ------------------------------------------------------------------------------
# Number of top relevant chunks to retrieve for study assistant / Q&A
RAG_TOP_K=4

# Minimum cosine similarity threshold for considering a chunk relevant
RAG_MIN_RELEVANCE_THRESHOLD=0.15

# Chunking sizes for document text extraction
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100

# Extra chunk candidates retrieved when assembling source-grounded assessments
ASSESSMENT_CANDIDATE_MARGIN=2
